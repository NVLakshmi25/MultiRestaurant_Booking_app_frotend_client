FILE 3: AppContext.tsx - Global State
TSX
import { createContext, useContext, useState } from "react";

// Create context (like a "container" for global data)
const AppContext = createContext(null);

export function AppContextProvider({ children }) {
  // ✅ User data (accessible everywhere)
  const [user, setUser] = useState(null);
  
  // ✅ Loading state
  const [isLoading, setIsLoading] = useState(false);
  
  // ✅ Restaurant data
  const [restaurants, setRestaurants] = useState([]);

  return (
    <AppContext.Provider
      value={{
        user,
        setUser,
        isLoading,
        setIsLoading,
        restaurants,
        setRestaurants,
      }}
    >
      {children}
    </AppContext.Provider>
  );
}

// Custom hook to use context
export function useAppContext() {
  const context = useContext(AppContext);
  if (!context) {
    throw new Error("Must be used inside AppContextProvider");
  }
  return context;
}
Why Context?

Without it, you'd pass data through EVERY component
With it, data is accessible from ANY component
Code
❌ WITHOUT CONTEXT (Data drilling):
Home → Component1 → Component2 → Component3 → (use data)

✅ WITH CONTEXT:
Home ───────────────────────────┐
                                 ├─ AppContext
Component1 ──────────────────────┤
Component2 ──────────────────────┤
Component3 ──────────────────────┘

(Any component can access data directly)
FILE 4: lib/api.ts - Backend Communication
TSX
import axios from "axios";

// Create axios instance with base URL
const api = axios.create({
  baseURL: import.meta.env.VITE_API_URL || "http://localhost:5000/api",
  headers: {
    "Content-Type": "application/json",
  },
});

// Add token to every request (for authentication)
api.interceptors.request.use(
  (config) => {
    const token = localStorage.getItem("token");
    if (token) {
      config.headers.Authorization = `Bearer ${token}`;
    }
    return config;
  },
  (error) => Promise.reject(error)
);

// Handle errors from backend
api.interceptors.response.use(
  (response) => response,
  (error) => {
    if (error.response?.status === 401) {
      // Not logged in - redirect to login
      localStorage.removeItem("token");
      window.location.href = "/login";
    }
    return Promise.reject(error);
  }
);

export default api;
What this does:

📡 Creates connection to backend
🔐 Adds authentication token to requests
❌ Handles errors automatically
