FILE 2: RestaurantWizard.tsx - Registration Form
This is where restaurant owners register their restaurant.

TSX
// ================== IMPORTS ==================
import { useEffect, useState } from "react";
import { Utensils, Upload, Image as ImageIcon } from "lucide-react";
import toast from "react-hot-toast";
import { useAppContext } from "../../context/AppContext";
import api from "../../lib/api";

// ================== AVAILABLE TIME SLOTS ==================
// These are the times customers can book
const DEFAULT_SLOTS = [
  "12:00", "13:00", "14:00", "17:00", "17:30", "18:00", 
  "18:30", "19:00", "19:30", "20:00", "20:30", "21:00", "21:30"
];

// Times that are selected by default
const DEFAULT_SELECTED_SLOTS = [
  "17:00", "17:30", "18:00", "18:30", "19:00", 
  "19:30", "20:00", "20:30", "21:00", "21:30"
];

// ================== COMPONENT ==================
export default function RestaurantWizard({ setRestaurant }) {
  const { user } = useAppContext(); // Get logged-in user

  // ================== FORM STATE (Store user input) ==================
  const [name, setName] = useState("");          // Restaurant name
  const [description, setDescription] = useState(""); // About restaurant
  const [cuisine, setCuisine] = useState("");    // Food type
  const [priceRange, setPriceRange] = useState("$$"); // $ to $$$$
  const [location, setLocation] = useState("");  // City name
  const [address, setAddress] = useState("");    // Full address
  const [chef, setChef] = useState("");          // Head chef name
  const [tags, setTags] = useState("");          // Special features

  // ================== IMAGE STATE ==================
  const [imageFile, setImageFile] = useState(null);  // Actual image file
  const [imagePreview, setImagePreview] = useState(""); // Preview to show

  // ================== RESTAURANT SETTINGS ==================
  const [availableSlots, setAvailableSlots] = useState(DEFAULT_SELECTED_SLOTS);
  const [totalSeats, setTotalSeats] = useState("20"); // Capacity

  // ================== LOADING STATE ==================
  const [formLoading, setFormLoading] = useState(false); // While submitting

  // ================== HANDLE IMAGE UPLOAD ==================
  const handleImageChange = (event) => {
    const file = event.target.files?.[0]; // Get selected file

    if (!file) return; // No file selected

    // ✅ Check file type (must be JPG, PNG, WebP)
    const allowedTypes = ["image/jpeg", "image/png", "image/webp"];
    if (!allowedTypes.includes(file.type)) {
      toast.error("Please select a JPG, PNG or WebP image.");
      event.target.value = "";
      return;
    }

    // ✅ Check file size (must be < 5MB)
    const maxSize = 5 * 1024 * 1024; // 5MB in bytes
    if (file.size > maxSize) {
      toast.error("Image size must be less than 5 MB.");
      event.target.value = "";
      return;
    }

    // ✅ Cleanup old preview
    if (imagePreview.startsWith("blob:")) {
      URL.revokeObjectURL(imagePreview);
    }

    // ✅ Save file and create preview
    setImageFile(file);
    const previewUrl = URL.createObjectURL(file);
    setImagePreview(previewUrl);
  };

  // ================== HANDLE TIME SLOT TOGGLE ==================
  const toggleSlot = (slot) => {
    setAvailableSlots((currentSlots) => {
      if (currentSlots.includes(slot)) {
        // If already selected, remove it
        return currentSlots.filter((s) => s !== slot);
      } else {
        // If not selected, add it
        return [...currentSlots, slot].sort();
      }
    });
  };

  // ================== VALIDATE & SUBMIT FORM ==================
  const handleCreateRestaurant = async (event) => {
    event.preventDefault(); // Prevent page reload

    // ✅ Check if user is logged in
    if (!user) {
      toast.error("You must be logged in to register a restaurant.");
      return;
    }

    // ✅ Validate all fields
    if (!name.trim()) { toast.error("Restaurant name is required."); return; }
    if (!description.trim()) { toast.error("Description is required."); return; }
    if (!cuisine.trim()) { toast.error("Cuisine type is required."); return; }
    if (!location.trim()) { toast.error("Location is required."); return; }
    if (!address.trim()) { toast.error("Address is required."); return; }
    if (!chef.trim()) { toast.error("Chef name is required."); return; }

    // Validate capacity (seats)
    const seats = Number(totalSeats);
    if (!Number.isInteger(seats) || seats < 1) {
      toast.error("Capacity must be at least 1 seat.");
      return;
    }
    if (seats > 1000) {
      toast.error("Capacity cannot exceed 1000 seats.");
      return;
    }

    // Validate time slots
    if (availableSlots.length === 0) {
      toast.error("Please select at least one available slot.");
      return;
    }

    // Validate image
    if (!imageFile) {
      toast.error("Please upload a restaurant cover image.");
      return;
    }

    // ================== ALL VALIDATION PASSED - SUBMIT ==================
    setFormLoading(true);

    try {
      // Create FormData (special format for file upload)
      const formData = new FormData();
      
      // Add all restaurant data
      formData.append("name", name.trim());
      formData.append("description", description.trim());
      formData.append("cuisine", cuisine.trim());
      formData.append("priceRange", priceRange);
      formData.append("location", location.trim());
      formData.append("address", address.trim());
      formData.append("chef", chef.trim());

      // Process tags (split by comma)
      const tagArray = tags
        .split(",")
        .map((tag) => tag.trim())
        .filter(Boolean);
      formData.append("tags", tagArray.join(","));

      // Add time slots
      formData.append("availableSlots", availableSlots.join(","));

      // Add seats
      formData.append("totalSeats", String(seats));

      // Add image file
      formData.append("image", imageFile);

      // ================== SEND TO BACKEND ==================
      const response = await api.post("/owner/restaurant", formData);

      // Get restaurant from response
      const restaurant = response.data?.restaurant ?? response.data;

      if (!restaurant) {
        throw new Error("Restaurant data not returned by server.");
      }

      // Update parent component
      setRestaurant(restaurant);

      // Show success message
      toast.success("Restaurant registered! Awaiting Admin approval.");

      // Reset form
      setName("");
      setDescription("");
      setCuisine("");
      setPriceRange("$$");
      setLocation("");
      setAddress("");
      setChef("");
      setTags("");
      setTotalSeats("20");
      setAvailableSlots(DEFAULT_SELECTED_SLOTS);
      setImageFile(null);
      setImagePreview("");

    } catch (error) {
      // Show error message
      const message =
        error?.response?.data?.message ||
        error?.message ||
        "Failed to register restaurant. Please try again.";
      toast.error(message);

    } finally {
      setFormLoading(false); // Stop loading
    }
  };

  // ================== RENDER JSX ==================
  return (
    <form onSubmit={handleCreateRestaurant} className="space-y-5">
      
      {/* Restaurant Name Input */}
      <div>
        <label>Restaurant Name</label>
        <input
          type="text"
          value={name}
          onChange={(e) => setName(e.target.value)}
          placeholder="e.g. L'Artiste"
          maxLength={100}
        />
      </div>

      {/* Description Input */}
      <div>
        <label>Description</label>
        <textarea
          value={description}
          onChange={(e) => setDescription(e.target.value)}
          placeholder="Describe your restaurant..."
          maxLength={1000}
          rows={4}
        />
      </div>

      {/* Image Upload */}
      <div>
        <label>Restaurant Cover Image</label>
        {imagePreview && (
          <img src={imagePreview} alt="Preview" />
        )}
        <input
          type="file"
          accept="image/png,image/jpeg,image/webp"
          onChange={handleImageChange}
        />
      </div>

      {/* Price Range */}
      <div>
        <label>Price Range</label>
        <select value={priceRange} onChange={(e) => setPriceRange(e.target.value)}>
          <option value="$">$ (Budget)</option>
          <option value="$$">$$ (Moderate)</option>
          <option value="$$$">$$$ (Upscale)</option>
          <option value="$$$$">$$$$ (Fine Dining)</option>
        </select>
      </div>

      {/* Location & Capacity */}
      <div>
        <label>Location</label>
        <input value={location} onChange={(e) => setLocation(e.target.value)} />
      </div>

      <div>
        <label>Total Capacity (seats)</label>
        <input
          type="number"
          min={1}
          max={1000}
          value={totalSeats}
          onChange={(e) => setTotalSeats(e.target.value)}
        />
      </div>

      {/* Available Time Slots */}
      <div>
        <label>Available Time Slots</label>
        <div className="grid grid-cols-3 gap-2">
          {DEFAULT_SLOTS.map((slot) => (
            <button
              key={slot}
              type="button"
              onClick={() => toggleSlot(slot)}
              className={availableSlots.includes(slot) ? "selected" : ""}
            >
              {slot}
            </button>
          ))}
        </div>
      </div>

      {/* Submit Button */}
      <button
        type="submit"
        disabled={formLoading}
        className="w-full bg-blue-500 text-white py-2 rounded"
      >
        {formLoading ? "Submitting..." : "Register Restaurant"}
      </button>
    </form>
  );
}
Key Concepts Explained:

